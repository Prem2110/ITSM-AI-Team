{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/api/(.*)",
      "target": "/api/$1",
      "destination": "itsm-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(assets/.*|.*\\.js|.*\\.css|.*\\.png|.*\\.ico|.*\\.svg|.*\\.woff2?)$",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "localDir": "resources",
      "authenticationType": "none"
    }
  ]
}
